{
  "name": "@workspace/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema ./schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ./schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./schema.prisma",
    "db:migrate:status": "prisma migrate status --schema ./schema.prisma",
    "db:studio": "prisma studio --schema ./schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/typescript-config": "workspace:*",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
